{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next/React overrides of the ESM/Node-oriented base.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Resolve @clasher/shared from source for type-checking (no pre-build needed);
    // Next's bundler resolves the workspace package at build time.
    "baseUrl": ".",
    "paths": {
      "@clasher/shared": ["../../packages/shared/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
