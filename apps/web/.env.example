# Web app environment (Auth.js / Google OAuth). See apps/web/AUTH.md.
# M0 ships placeholders; the real Google credentials are a prereq of the M1 auth
# slice (DESIGN D-1). Secrets are out-of-band, never committed (NFR-3) — in prod
# these come from the `web-auth` k8s Secret (deploy/k8s/SECRETS.md).

# Auth.js signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Public origin Auth.js uses to build callback URLs and to decide Secure cookies.
# Prod: https://clasher.skpodduturi.dev
AUTH_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Web client (dedicated project). Server-only — never
# exposed to the browser. Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NestJS API base URL for the server-side sign-in upsert (no trailing /api — the
# API adds its own /api prefix). Prod (in-cluster Service DNS):
#   http://api.clasher-backend.svc.cluster.local:3000
# Local dev: point at your running API (the API and `next dev` both default to
# :3000, so run the API on another port, e.g. PORT=3001).
API_BASE_URL=http://localhost:3001
